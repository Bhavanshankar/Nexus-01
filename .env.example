# Copy to .env and fill in real values locally. Never commit .env.
# Only the OpenAI key is required for the live path (embeddings + CrewAI model).
# run_local_demo.py and pytest tests/ need no credentials.

OPENAI_API_KEY=sk-your-key-here
# Optional: model used by the CrewAI agent roles (default gpt-4o-mini)
NEXUS_CREWAI_MODEL=gpt-4o-mini
# Must match the model the index was built with (checked against vector_store/manifest.json)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Structured JSON logs: level defaults to DEBUG; set a file to keep stdout/stderr quiet
LOG_LEVEL=DEBUG
# NEXUS_LOG_FILE=logs/nexus.jsonl

# Data locations (defaults are repository-relative)
# NEXUS_DB_PATH=data/meridian.db
# NEXUS_CHROMA_PATH=vector_store/chroma
# NEXUS_KB_ROOT=knowledge_base/nexus_unstructured_knowledge_base

# MCP server ports (servers bind to 127.0.0.1)
# NEXUS_BANKING_PORT=8101
# NEXUS_INSURANCE_PORT=8102
# NEXUS_WEALTH_PORT=8103
# NEXUS_CONCIERGE_OPS_PORT=8104
# Orchestrator's MCP client endpoints (defaults match the ports above)
# NEXUS_BANKING_URL=http://127.0.0.1:8101/mcp
# NEXUS_INSURANCE_URL=http://127.0.0.1:8102/mcp
# NEXUS_WEALTH_URL=http://127.0.0.1:8103/mcp
# NEXUS_CONCIERGE_OPS_URL=http://127.0.0.1:8104/mcp

# Trust boundary: servers refuse caller_scope=internal_service unless this is 1 (loopback demo only)
# NEXUS_TRUST_INTERNAL_SCOPE=0

# Use the OS certificate store for outbound TLS (needed behind TLS-inspecting proxies); 0 disables
# NEXUS_USE_SYSTEM_TRUSTSTORE=1
